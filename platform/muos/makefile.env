# muos
OPT = -O3 -Ofast -fomit-frame-pointer
CFLAGS = -mcpu=cortex-a53 -flto
SDL = SDL2
GL = GLES
# Never PREFIX_LOCAL: /opt/nextui holds NextUI's patched SDL, which muOS devices don't have.
CFLAGS += -I$(PREFIX)/include
LDFLAGS = -L$(PREFIX)/lib
# multiarch support
CFLAGS += -I$(PREFIX)/include/$(CROSS_TRIPLE)
LDFLAGS += -L$(PREFIX)/lib/$(CROSS_TRIPLE)
CFLAGS += $$(pkg-config --cflags sdl2)
LDFLAGS += $$(pkg-config --libs sdl2) -lGLESv2
CFLAGS += -DUSE_$(SDL) -DUSE_$(GL) -DGL_GLEXT_PROTOTYPES
LDFLAGS += -l$(SDL)_image -l$(SDL)_ttf -lpthread -ldl -lm -lz
